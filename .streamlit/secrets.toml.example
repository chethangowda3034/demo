# Copy these settings into Streamlit Community Cloud's Secrets settings.
# Replace every placeholder first. Never commit real values in secrets.toml.
APP_ENV = "production"
ENABLE_DEMO_ACCOUNTS = "false"
MONGODB_URI = "mongodb+srv://<database-user>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DATABASE = "marpol_safe"
BOOTSTRAP_ADMIN_PASSWORD = "<replace-with-a-unique-password-of-at-least-8-characters>"
