# Local-only demo defaults. run_app.bat explicitly enables demo accounts.
APP_ENV=demo
ENABLE_DEMO_ACCOUNTS=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=marpol_safe
MONGODB_TLS=false

# For a remote MongoDB deployment, use its TLS-enabled connection string.
# Remote MongoDB URIs require TLS even when MONGODB_TLS is false.
